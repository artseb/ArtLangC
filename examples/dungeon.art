// A very small duel. Classes, inheritance, enums, Math.random.
// Output is deterministic thanks to Math.seed.
//
// Run:  ./bin/art examples/dungeon.art

Math.seed(42)

enum Stance { Aggressive, Defensive }

class Actor {
    name = ""
    hp = 0
    maxHp = 0
    atk = 0

    fun Actor(name, hp, atk) {
        this.name = name
        this.hp = hp
        this.maxHp = hp
        this.atk = atk
    }

    get alive() {
        return this.hp > 0
    }

    fun hit(target, stance) {
        local dmg = Math.floor(Math.random(this.atk, this.atk * 2))
        if (stance == Stance.Defensive) {
            dmg = Math.floor(dmg / 2)
        }
        target.hp = Math.max(0, target.hp - dmg)
        return dmg
    }

    fun toString() {
        return this.name + " [" + tostring(this.hp) + "/" +
                        tostring(this.maxHp) + "]"
    }
}

class Warrior extends Actor {
    fun Warrior(name) { super(name, 30, 4) }
}

class Rogue extends Actor {
    fun Rogue(name) { super(name, 20, 6) }
}

local hero = Warrior("Hero")
local foe  = Rogue("Shadow")

print("A duel begins.")
print("  " + tostring(hero))
print("  " + tostring(foe))

local round = 0
while (hero.alive and foe.alive) {
    round = round + 1
    print("round " + tostring(round) + ":")

    local a = hero.hit(foe, Stance.Aggressive)
    print("  " + hero.name + " hits " + foe.name +
          " for " + tostring(a) + "  ->  " + tostring(foe))
    if (!foe.alive) { break }

    local b = foe.hit(hero, Stance.Aggressive)
    print("  " + foe.name + " hits " + hero.name +
          " for " + tostring(b) + "  ->  " + tostring(hero))
}

if (hero.alive) {
    print(hero.name + " wins.")
} else {
    print(foe.name + " wins.")
}
